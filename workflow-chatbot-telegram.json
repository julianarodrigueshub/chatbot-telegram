{
  "name": "Chatbot Telegram - Temperatura OpenWeather",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "id": "telegram-trigger-001",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "queue-field-001",
              "name": "queue",
              "value": "={{ $json.message.text ? $json.message.text.trim().replace(/\\s+/g, ' ') : '' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "set-queue-001",
      "name": "Set - Criar queue",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.openweathermap.org/data/2.5/weather",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{ $json.queue }}"
            },
            {
              "name": "queue",
              "value": "={{ $json.queue }}"
            },
            {
              "name": "units",
              "value": "metric"
            },
            {
              "name": "lang",
              "value": "pt_br"
            },
            {
              "name": "appid",
              "value": "={{ $env.OPENWEATHER_API_KEY }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "http-openweather-001",
      "name": "HTTP Request - OpenWeather",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const data = $json;\nconst statusOk = data.cod === 200 || data.cod === \"200\";\nconst temperatureValid = data.main && typeof data.main.temp === \"number\";\nreturn [{ json: { ...data, valid: statusOk && temperatureValid } }];"
      },
      "id": "validate-001",
      "name": "Code - Validar resposta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        760,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "valid-condition-001",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-valid-001",
      "name": "IF - Resposta válida?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1000,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const temperatura = Math.round($json.main.temp);\nconst cidade = $json.name || 'cidade informada';\nreturn [{ json: { message: `🌤️ A temperatura em ${cidade} é de ${temperatura}°C.` } }];"
      },
      "id": "format-success-001",
      "name": "Code - Formatar mensagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1240,
        -100
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "={{ $json.message }}",
        "additionalFields": {}
      },
      "id": "telegram-success-001",
      "name": "Telegram - Enviar temperatura",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1480,
        -100
      ],
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "❌ Cidade não encontrada. Use o formato Cidade,UF,BR (ex.: São Paulo,SP,BR).",
        "additionalFields": {}
      },
      "id": "telegram-error-001",
      "name": "Telegram - Enviar erro",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1240,
        120
      ],
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "Telegram Bot"
        }
      }
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [
        [
          {
            "node": "Set - Criar queue",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set - Criar queue": {
      "main": [
        [
          {
            "node": "HTTP Request - OpenWeather",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Request - OpenWeather": {
      "main": [
        [
          {
            "node": "Code - Validar resposta",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Code - Validar resposta": {
      "main": [
        [
          {
            "node": "IF - Resposta válida?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF - Resposta válida?": {
      "main": [
        [
          {
            "node": "Code - Formatar mensagem",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Telegram - Enviar erro",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Code - Formatar mensagem": {
      "main": [
        [
          {
            "node": "Telegram - Enviar temperatura",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "versionId": "chatbot-telegram-openweather-2026",
  "tags": []
}